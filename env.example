# =========================
# Required
# =========================

PRIVATE_KEY=
RPC_URL=                        # Or use named aliases from foundry.toml: mainnet, celo_sepolia


# =========================
# Platform (commonly set)
# =========================

PLATFORM_NAME=                  # Hashed on-chain as the platform identifier
PLATFORM_ADMIN_ADDRESS=         # Receives platform admin rights after deploy (default: deployer)
PROTOCOL_ADMIN_ADDRESS=         # Receives protocol admin rights after deploy (default: deployer)
PLATFORM_ADAPTER_ADDRESS=       # ERC-2771 trusted forwarder for meta-txs (optional, can be set later)


# =========================
# Currencies + Tokens (required for production)
# =========================
# If CURRENCIES is unset, a TestToken is auto-deployed — for local dev only.
# Format: CURRENCIES=USD,EUR  →  TOKENS_PER_CURRENCY=0xUsdt,0xUsdc;0xEurt

CURRENCIES=
TOKENS_PER_CURRENCY=


# =========================
# Optional — fees and time constraints
# =========================

# Fees in basis points (10000 = 100%). Combined must not exceed 10000.
PROTOCOL_FEE_PERCENT=           # Default: 100 (1%)
PLATFORM_FEE_PERCENT=           # Default: 400 (4%) — KeepWhatsRaised defaults to 600

# Time values in seconds (0 = no constraint)
BUFFER_TIME=                    # Grace period after campaign deadline
CAMPAIGN_LAUNCH_BUFFER=         # Min lead time between campaign creation and launch
MINIMUM_CAMPAIGN_DURATION=      # Min duration a campaign must run (deadline - launchTime)
MAX_PAYMENT_EXPIRATION=         # PaymentTreasury only: max time before pending payment expires


# =========================
# Reuse existing contracts (leave blank to deploy fresh)
# =========================

GLOBAL_PARAMS_ADDRESS=
TREASURY_FACTORY_ADDRESS=
CAMPAIGN_INFO_FACTORY_ADDRESS=

ALL_OR_NOTHING_IMPLEMENTATION_ADDRESS=
KEEP_WHATS_RAISED_IMPLEMENTATION_ADDRESS=
PAYMENT_TREASURY_IMPLEMENTATION_ADDRESS=
TIME_CONSTRAINED_PAYMENT_TREASURY_IMPLEMENTATION_ADDRESS=


# =========================
# Testing / local dev only
# =========================

SIMULATE=                       # true/false — dry-run without broadcasting (default: false)
TOKEN_ADDRESS=                  # Reuse an existing TestToken (when CURRENCIES is unset)
TOKEN_NAME=""
TOKEN_SYMBOL=""
TOKEN_DECIMALS=                 # Default: 18
TOKEN_MINT_AMOUNT=              # Default: 10000000e18
BACKER1_ADDRESS=
BACKER2_ADDRESS=


# =========================
# Verification
# =========================

ETHERSCAN_API_KEY=
